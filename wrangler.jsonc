{
  "$schema": "https://unpkg.com/wrangler@4.165.0/config-schema.json",
  // Worker công khai: phục vụ site tĩnh trong dist và các API /api/*.
  // Trước đây Cloudflare tự sinh cấu hình này lúc deploy nhánh main; `wrangler preview`
  // (build cho nhánh khác và PR) bắt buộc có file cấu hình kèm khối "previews".
  "name": "trung-pcb-3d",
  "main": "worker/public/index.ts",
  "compatibility_date": "2026-11-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Chỉ /api/* chạy Worker trước; mọi đường khác trả thẳng tài nguyên tĩnh.
    "run_worker_first": ["/api/*"]
  },
  // database_id của D1 trung-3d (không phải bí mật).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trung-3d",
      "database_id": "2be89bf2-34a6-48d1-b285-42631d4e88a7",
      // Id của trung-3d-preview (giá trị tạm); cần để chạy `wrangler d1 migrations apply DB --remote --preview`.
      "preview_database_id": "7677d3c3-4b5b-4a31-8f1b-c611cf5f36d2",
      "migrations_dir": "migrations"
    }
  ],
  // Secrets (đặt bằng `wrangler secret put`): SHARED_SECRET, TURNSTILE_SECRET, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID.
  "vars": {
    "PUBLIC_SITE_URL": "https://trung-pcb-3d.minhlaductrung.workers.dev",
    "ADMIN_SITE_URL": "https://trung-3d-admin.minhlaductrung.workers.dev",
    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbyvHRfr8muFpvZDPBpha7SIMfya90zrxprtobUleQaB8JPxewNo9rzOpszdGGFpO0lw2Q/exec"
  },
  "previews": {
    // Bản preview dùng DB riêng và APPS_SCRIPT_URL rỗng (không gửi Telegram, Gmail, Drive).
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "trung-3d-preview",
        "database_id": "7677d3c3-4b5b-4a31-8f1b-c611cf5f36d2",
        "migrations_dir": "migrations"
      }
    ],
    "vars": {
      "APPS_SCRIPT_URL": ""
    }
  }
}
