{
  "$schema": "https://unpkg.com/wrangler@4.165.0/config-schema.json",
  // Worker admin: phục vụ UI quản trị trong dist-admin và API /api/* cho Trung.
  // Đăng nhập bằng mã một lần gửi qua email (ADMIN_EMAILS), phiên bằng cookie ký HMAC.
  "name": "trung-3d-admin",
  "main": "worker/admin/index.ts",
  "compatibility_date": "2026-11-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist-admin",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Cùng D1 với Worker công khai.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trung-3d",
      "database_id": "2be89bf2-34a6-48d1-b285-42631d4e88a7",
      "migrations_dir": "migrations"
    }
  ],
  // Secret (wrangler secret put -c wrangler.admin.jsonc): SHARED_SECRET (cùng giá trị Worker công khai), ADMIN_SESSION_SECRET.
  "vars": {
    // Email được phép, phân tách bằng dấu phẩy
    "ADMIN_EMAILS": "minhlaductrung@gmail.com",
    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbyvHRfr8muFpvZDPBpha7SIMfya90zrxprtobUleQaB8JPxewNo9rzOpszdGGFpO0lw2Q/exec",
    "PUBLIC_SITE_URL": "https://trung-pcb-3d.minhlaductrung.workers.dev"
  }
}
